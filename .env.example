# Environment-variable reference. JARVIS does not load this file automatically.
JARVIS_LOG_LEVEL=INFO
JARVIS_REALTIME_PROVIDER=openai
JARVIS_REALTIME_MODEL=gpt-realtime
JARVIS_REALTIME_VOICE=marin
JARVIS_GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
JARVIS_GEMINI_REALTIME_VOICE=Charon
JARVIS_SHOW_TRANSCRIPT=true

# Wake/audio runtime.
JARVIS_WAKE_MODEL_PATH=C:\path\to\jarvis.onnx
JARVIS_WAKE_THRESHOLD=0.68
JARVIS_WAKE_DEBOUNCE_SECONDS=2.0
JARVIS_AUDIO_OUTPUT_DEVICE=name:Speakers (your output device)|hostapi:Windows WASAPI
# Exact IMMDevice render endpoint used by paired GStreamer full-duplex AEC.
# Example shape: {0.0.0.00000000}.{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}
JARVIS_AUDIO_OUTPUT_WASAPI_DEVICE=
JARVIS_AUDIO_RING_BUFFER_SECONDS=2.5
JARVIS_AUDIO_PRE_ROLL_SECONDS=0.75
JARVIS_WAKE_COOLDOWN_SECONDS=1.0
JARVIS_INITIAL_REQUEST_TIMEOUT_SECONDS=8.0
JARVIS_FOLLOW_UP_TIMEOUT_SECONDS=15.0
JARVIS_MAX_UTTERANCE_SECONDS=15.0

# Current paired sensor path. When active-speaker shadow is enabled, one GStreamer
# media graph owns the physical microphone and speaker path. Raw paired DJI PCM is
# retained for synchronized LR-ASD evidence; WebRTC-AEC-cleaned PCM is canonical
# for wake + conversation. JARVIS_AUDIO_INPUT_DEVICE and JARVIS_AUDIO_OUTPUT_DEVICE
# are not used by this paired full-duplex path.
JARVIS_VISION_ENABLED=true
JARVIS_SPEAKER_SHADOW_ENABLED=true
JARVIS_ACTIVE_SPEAKER_SHADOW_ENABLED=true
JARVIS_LR_ASD_MODEL_PATH=C:\path\to\pretrain_AVA.model

# Set provider keys only in your local process environment.
OPENAI_API_KEY=
GOOGLE_API_KEY=
