# JARVIS configuration reference.
#
# Normal operation does NOT require setting these on every launch.
# Run `jarvis-setup` once; non-secret machine settings are persisted under
# %LOCALAPPDATA%\JARVIS\machine.json on Windows.
#
# Persisted machine settings are authoritative by default. To deliberately let
# runtime JARVIS_* environment values override persisted settings for diagnostics,
# explicitly set JARVIS_RUNTIME_ENV_OVERRIDES=true for that diagnostic process.
#
# Production JARVIS uses ONE active cloud-AI provider/account at a time. Only the
# active provider's key is required. The inactive provider key is optional and is
# useful only when intentionally switching providers or running research bake-offs.
# Secrets are never written to machine.json.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional machine-profile path override and explicit diagnostic override mode.
JARVIS_MACHINE_CONFIG=
JARVIS_RUNTIME_ENV_OVERRIDES=false

# Canonical production cloud-AI provider. All production cloud intelligence roles
# (realtime voice, structured memory extraction, and future reasoning/tool roles)
# must use this provider family/account. Provider-specific model IDs may differ by
# capability, but a subsystem may not select a second provider independently.
JARVIS_AI_PROVIDER=gemini

# Legacy migration alias only. Existing machine profiles containing this setting
# remain readable, but new configuration must use JARVIS_AI_PROVIDER.
# JARVIS_REALTIME_PROVIDER=

# Realtime role/model values. OpenAI and Gemini model/voice values can both remain
# configured so an intentional provider switch is reversible; only the active
# provider is called at runtime.
JARVIS_LOG_LEVEL=INFO
JARVIS_REALTIME_MODEL=gpt-realtime
JARVIS_REALTIME_VOICE=marin
JARVIS_GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
JARVIS_GEMINI_REALTIME_VOICE=Charon
JARVIS_SHOW_TRANSCRIPT=true
JARVIS_STARTUP_GREETING=true

# Step-4 memory rollout. Candidate extraction uses JARVIS_AI_PROVIDER automatically;
# there is intentionally no JARVIS_MEMORY_CANDIDATE_EXTRACTION_PROVIDER setting.
JARVIS_MEMORY_ENABLED=false
JARVIS_MEMORY_CANDIDATE_EXTRACTION_ENABLED=false
JARVIS_MEMORY_CANDIDATE_EXTRACTION_MODEL=

# Wake/audio values. `jarvis-setup` stores stable name+host-api selectors,
# never volatile PortAudio indexes. Production conversation audio requires a
# 48 kHz input and 48 kHz output so LiveKit MediaDevices owns one WebRTC
# AEC/NS/HPF/AGC loop end to end.
JARVIS_WAKE_MODEL_PATH=C:\path\to\jarvis.onnx
JARVIS_WAKE_THRESHOLD=0.68
JARVIS_WAKE_DEBOUNCE_SECONDS=2.0
JARVIS_AUDIO_INPUT_DEVICE=name:Capture Input terminal (OsmoPocket3)|hostapi:Windows WASAPI
JARVIS_AUDIO_OUTPUT_DEVICE=name:24'TV (NVIDIA High Definition Audio)|hostapi:Windows WASAPI
JARVIS_AUDIO_RING_BUFFER_SECONDS=2.5
JARVIS_AUDIO_PRE_ROLL_SECONDS=0.75
JARVIS_WAKE_COOLDOWN_SECONDS=1.0
JARVIS_INITIAL_REQUEST_TIMEOUT_SECONDS=8.0
JARVIS_FOLLOW_UP_TIMEOUT_SECONDS=15.0
JARVIS_MAX_UTTERANCE_SECONDS=15.0

# Step-3 sensor/identity feature values.
JARVIS_VISION_ENABLED=true
JARVIS_BLAZEFACE_MODEL_PATH=
JARVIS_SPEAKER_SHADOW_ENABLED=true
JARVIS_ACTIVE_SPEAKER_SHADOW_ENABLED=false
JARVIS_LR_ASD_MODEL_PATH=C:\path\to\pretrain_AVA.model

# Historical only: ADR-011 supersedes the GStreamer conversation-render path.
# Production conversation playback ignores this variable.
JARVIS_AUDIO_OUTPUT_WASAPI_DEVICE=
